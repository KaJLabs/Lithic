@@ -0,0 +1,34 @@
+# Separately disabled native custody extension
+
+This additive chain candidate pairs with Lithic's `feat/native-custody-20261107`
+branch. It must not be substituted into a previously reviewed binary/source pin.
+No activation, upgrade height, live denomination, genesis or store schema is
+changed here. Default builds retain the existing nonpayable gateway behavior.
+
+Both `lithovm_chain_lab,lithovm_bank_candidate` tags are required to select the
+bank-backed profile. Its matching Rust library must export `lithovm_execute_v3`.
+The new StateDB helpers access the existing balance journal; they do not create
+a native balance store. SDK bank/account commit remains the ordinary EVM path.
+The candidate keeper policy rejects module, blocked and non-EVM auth accounts.
+Actual bank/auth reads restore the pinned SDK KV rates even inside an EVM query
+context that otherwise has zero KV pricing, and consume the same native frame
+budget. New bookkeeping rates are provisional, subject to Foundation review.
+
+Local tests in `native_custody_lab_test.go` exercise simulation, prefunding,
+signed-message gateway deployment, failure rollback, successful native transfer
+and exact SDK supply conservation against the real synthetic application. The
+integration module additionally tests enclosing EVM revert and OOG/policy
+failure after a partial journal settlement. None starts a network node.
+
+With the matching compiler/FFI and disclosed SDK compatibility patches:
+
+```sh
+go test -tags lithovm_chain_lab,lithovm_bank_candidate ./x/evm/keeper \
+  -run 'TestKeeperTestSuite/(TestNativeCustody|TestLithoVMCandidate)'
+```
+
+The fixture is generated with the matching compiler:
+`lithc --emit lithovm x/evm/keeper/testdata/native_custody.lithic`.
+Keep the emitted JSON/source comparison as review evidence. Final chain/FFI
+pins, security review, gas/custody policy, upgrade and ulitho compatibility,
+network tests and production approval remain required before use.
diff --git a/x/evm/keeper/native_custody_lab.go b/x/evm/keeper/native_custody_lab.go
new file mode 100644
index 0000000..6d02bd1
--- /dev/null
+++ b/x/evm/keeper/native_custody_lab.go
@@ -0,0 +1,29 @@
+//go:build lithovm_bank_candidate
+
+package keeper
+
+import (
+	"errors"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	"github.com/ethereum/go-ethereum/common"
+	evmostypes "github.com/evmos/evmos/v20/types"
+)
+
+// ValidateNativeBalanceAddress grants no mint/burn authority. Native custody
+// uses the ordinary EVM balance journal/commit path, retaining module-account
+// and blocked-address protections. This policy is absent from ordinary builds.
+func (k *Keeper) ValidateNativeBalanceAddress(ctx sdk.Context, addr common.Address) error {
+	account := k.accountKeeper.GetAccount(ctx, sdk.AccAddress(addr.Bytes()))
+	if account != nil {
+		if _, module := account.(sdk.ModuleAccountI); module {
+			return errors.New("native custody cannot access module accounts")
+		}
+		if _, ethereum := account.(evmostypes.EthAccountI); !ethereum {
+			return errors.New("native custody requires an EVM-compatible bank account")
+		}
+	}
+	if k.bankKeeper.BlockedAddr(sdk.AccAddress(addr.Bytes())) {
+		return errors.New("native custody cannot access blocked bank accounts")
+	}
+	return nil
+}
