@@ -0,0 +1,123 @@
+//go:build lithovm_chain_lab && lithovm_bank_candidate
+
+package keeper_test
+
+import (
+	"bytes"
+	_ "embed"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"strings"
+
+	storetypes "cosmossdk.io/store/types"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	authtypes "github.com/cosmos/cosmos-sdk/x/auth/types"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/crypto"
+	evmtypes "github.com/evmos/evmos/v20/x/evm/types"
+	nativechain "lithic.local/native-chain-lab"
+)
+
+// Compiled from the adjacent native_custody.lithic using the candidate lithc.
+//
+//go:embed testdata/native_custody.json
+var custodyArtifact []byte
+
+func (suite *KeeperTestSuite) TestNativeCustodyPolicyRejectsModuleAndNonEVMAccounts() {
+	suite.SetupTest()
+	ctx := suite.network.GetContext()
+	app := suite.network.App
+	ordinary := suite.keyring.GetAddr(0)
+	suite.Require().NoError(app.EvmKeeper.ValidateNativeBalanceAddress(ctx, ordinary))
+	module := app.AccountKeeper.GetModuleAddress(evmtypes.ModuleName)
+	suite.Require().NotEmpty(module)
+	suite.Require().Error(app.EvmKeeper.ValidateNativeBalanceAddress(ctx, common.BytesToAddress(module)))
+	plain := common.HexToAddress("0x8801")
+	account := app.AccountKeeper.NewAccount(ctx, authtypes.NewBaseAccountWithAddress(sdk.AccAddress(plain.Bytes())))
+	app.AccountKeeper.SetAccount(ctx, account)
+	suite.Require().Error(app.EvmKeeper.ValidateNativeBalanceAddress(ctx, plain))
+	absent := common.HexToAddress("0x8802")
+	meter := storetypes.NewInfiniteGasMeter()
+	suite.Require().NoError(app.EvmKeeper.ValidateNativeBalanceAddress(ctx.WithGasMeter(meter), absent))
+	suite.Require().Greater(meter.GasConsumed(), uint64(0), "auth policy read escaped SDK meter")
+}
+
+// Exercise the actual EVM message transition, account keeper and bank keeper.
+// This is a local synthetic application test, with no node or RPC listener.
+func (suite *KeeperTestSuite) TestNativeCustodySignedMessageBankSupplyAndRollback() {
+	suite.enableFeemarket = true
+	defer func() { suite.enableFeemarket = false }()
+	suite.SetupTest()
+	ctx := suite.network.GetContext()
+	app := suite.network.App
+	sender := suite.keyring.GetKey(0)
+	var artifact struct {
+		Bytecode string `json:"bytecode"`
+	}
+	suite.Require().NoError(json.Unmarshal(custodyArtifact, &artifact))
+	code, err := hex.DecodeString(strings.TrimPrefix(artifact.Bytecode, "0x"))
+	suite.Require().NoError(err)
+	owner := suite.keyring.GetAddr(0)
+	recipient := common.HexToAddress("0x7701")
+	ownerArgs, err := hex.DecodeString(fmt.Sprintf("4c56414c01000104%064x", owner.Bytes()))
+	suite.Require().NoError(err)
+	deploy, err := nativechain.EncodeGatewayDeploy(code, crypto.Keccak256Hash([]byte("initialize(address)")), ownerArgs)
+	suite.Require().NoError(err)
+	cfg, err := app.EvmKeeper.EVMConfig(ctx, ctx.BlockHeader().ProposerAddress, suite.network.GetEIP155ChainID())
+	suite.Require().NoError(err)
+	invoke := func(payload []byte, to common.Address, value *big.Int, commit bool) *evmtypes.MsgEthereumTxResponse {
+		msg, err := suite.factory.GenerateGethCoreMsg(sender.Priv, evmtypes.EvmTxArgs{To: &to, Amount: value, Input: payload, GasLimit: 10000000})
+		suite.Require().NoError(err)
+		result, err := app.EvmKeeper.ApplyMessageWithConfig(ctx, msg, nil, commit, cfg, app.EvmKeeper.TxConfig(ctx, common.Hash{}))
+		suite.Require().NoError(err)
+		return result
+	}
+	// Dry deployment predicts the address but must not create native state.
+	preview := invoke(deploy, nativechain.LabAddress, big.NewInt(0), false)
+	suite.Require().False(preview.Failed(), preview.VmError)
+	raw, err := nativechain.DecodeGatewayResult(preview.Ret)
+	suite.Require().NoError(err)
+	suite.Require().Len(raw, 40)
+	vault := common.BytesToAddress(raw[20:])
+	nativeKey := []byte("lithovm/v1/contracts/" + hex.EncodeToString(vault.Bytes()))
+	key := app.GetKey("lithovm")
+	suite.Require().False(ctx.KVStore(key).Has(nativeKey))
+	// Ordinary native EVM transfer funds the address before deployment.
+	funded := invoke(nil, vault, big.NewInt(100), true)
+	suite.Require().False(funded.Failed(), funded.VmError)
+	beforeSupply := app.BankKeeper.GetSupply(ctx, cfg.Params.EvmDenom)
+	deployed := invoke(deploy, nativechain.LabAddress, big.NewInt(0), true)
+	suite.Require().False(deployed.Failed(), deployed.VmError)
+	suite.Require().Equal(int64(100), app.EvmKeeper.GetBalance(ctx, vault).Int64())
+	suite.Require().True(ctx.KVStore(key).Has(nativeKey))
+	pay := func(accept bool) []byte {
+		flag := 0
+		if accept {
+			flag = 1
+		}
+		args, err := hex.DecodeString(fmt.Sprintf("4c56414c01000304%064x02%064x03%064x", recipient.Bytes(), 7, flag))
+		suite.Require().NoError(err)
+		payload, err := nativechain.EncodeGatewayCall(vault, crypto.Keccak256Hash([]byte("pay(address,u256,bool)")), args)
+		suite.Require().NoError(err)
+		return payload
+	}
+	beforeRecord := append([]byte(nil), ctx.KVStore(key).Get(nativeKey)...)
+	// Simulation and native require failure both discard every state layer.
+	simulation := invoke(pay(true), nativechain.LabAddress, big.NewInt(0), false)
+	suite.Require().False(simulation.Failed(), simulation.VmError)
+	failed := invoke(pay(false), nativechain.LabAddress, big.NewInt(0), true)
+	suite.Require().True(failed.Failed())
+	suite.Require().Empty(failed.Logs)
+	suite.Require().Equal(int64(100), app.EvmKeeper.GetBalance(ctx, vault).Int64())
+	suite.Require().Zero(app.EvmKeeper.GetBalance(ctx, recipient).Sign())
+	suite.Require().True(bytes.Equal(beforeRecord, ctx.KVStore(key).Get(nativeKey)))
+	paid := invoke(pay(true), nativechain.LabAddress, big.NewInt(0), true)
+	suite.Require().False(paid.Failed(), paid.VmError)
+	suite.Require().Len(paid.Logs, 2)
+	suite.Require().Equal(int64(93), app.EvmKeeper.GetBalance(ctx, vault).Int64())
+	suite.Require().Equal(int64(7), app.EvmKeeper.GetBalance(ctx, recipient).Int64())
+	suite.Require().Equal(beforeSupply, app.BankKeeper.GetSupply(ctx, cfg.Params.EvmDenom), "native settlement changed SDK supply")
+	suite.Require().False(bytes.Equal(beforeRecord, ctx.KVStore(key).Get(nativeKey)))
+}
