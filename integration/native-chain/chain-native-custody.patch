+++ b/x/evm/statedb/native_balance.go
@@ -0,0 +1,95 @@
+// Copyright Tharsis Labs Ltd.(Evmos)
+// SPDX-License-Identifier:ENCL-1.0(https://github.com/evmos/evmos/blob/main/LICENSE)
+package statedb
+
+import (
+	"errors"
+	"math/big"
+
+	storetypes "cosmossdk.io/store/types"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+// NativeBalancePolicy is implemented only by the separately enabled custody
+// keeper. A generic StateDB keeper must not silently grant native bank access.
+type NativeBalancePolicy interface {
+	ValidateNativeBalanceAddress(sdk.Context, common.Address) error
+}
+
+// ReadNativeBalance returns the current EVM-frame balance, including prior
+// journalled transfers, while forwarding actual SDK reads through the supplied
+// gas meter. It never changes SDK context/state or exposes a mutable balance.
+func (s *StateDB) ReadNativeBalance(addr common.Address, meter storetypes.GasMeter) (*big.Int, bool, error) {
+	object, err := s.nativeBalanceObject(addr, meter)
+	if err != nil {
+		return nil, false, err
+	}
+	if object == nil {
+		return new(big.Int), false, nil
+	}
+	return new(big.Int).Set(object.Balance()), true, nil
+}
+
+// ApplyNativeBalance journals one prevalidated bank change. It keeps existing
+// nonce/code intact and performs no SDK write before the ordinary EVM commit.
+func (s *StateDB) ApplyNativeBalance(addr common.Address, before, after *big.Int, meter storetypes.GasMeter) error {
+	if before == nil || after == nil || before.Sign() < 0 || before.BitLen() > 256 || after.Sign() < 0 || after.BitLen() > 256 {
+		return errors.New("native balance is outside uint256")
+	}
+	object, err := s.nativeBalanceObject(addr, meter)
+	if err != nil {
+		return err
+	}
+	current := new(big.Int)
+	if object != nil {
+		current.Set(object.Balance())
+	}
+	if current.Cmp(before) != 0 {
+		return errors.New("native balance changed before settlement")
+	}
+	if object == nil {
+		// Already checked with the metered keeper above. Do not perform a
+		// second unmetered getOrNewStateObject lookup here.
+		object = newObject(s, addr, Account{})
+		s.journal.append(createObjectChange{account: &addr})
+		s.setStateObject(object)
+	}
+	object.SetBalance(new(big.Int).Set(after))
+	return nil
+}
+
+func (s *StateDB) nativeBalanceObject(addr common.Address, meter storetypes.GasMeter) (*stateObject, error) {
+	policy, ok := s.keeper.(NativeBalancePolicy)
+	if !ok || meter == nil {
+		return nil, errors.New("native custody policy/meter unavailable")
+	}
+	// EVM ante/query contexts intentionally zero SDK KV pricing. Native bank
+	// reads are additional work, so restore the pinned SDK schedule explicitly
+	// for these reads only. Otherwise estimateGas underprices the same call.
+	ctx := s.ctx.WithGasMeter(meter).
+		WithKVGasConfig(storetypes.KVGasConfig()).
+		WithTransientKVGasConfig(storetypes.TransientGasConfig())
+	if err := policy.ValidateNativeBalanceAddress(ctx, addr); err != nil {
+		return nil, err
+	}
+	// Use the same live object cache as GetBalance: a raw bank query would miss
+	// transfers staged earlier in this EVM transaction.
+	object := s.stateObjects[addr]
+	if object != nil && object.suicided {
+		return nil, errors.New("native custody cannot settle a self-destructed EVM account")
+	}
+	if object == nil {
+		account := s.keeper.GetAccount(ctx, addr)
+		if account == nil {
+			return nil, nil
+		}
+		object = newObject(s, addr, *account)
+		s.setStateObject(object)
+	}
+	value := object.Balance()
+	if value.Sign() < 0 || value.BitLen() > 256 {
+		return nil, errors.New("native balance is outside uint256")
+	}
+	return object, nil
+}
