{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithic.at/schemas/lithovm.artifact.schema.json",
  "title": "Lithic native LithoVM artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactVersion",
    "compiler",
    "compilerVersion",
    "contractName",
    "target",
    "bytecodeVersion",
    "sourceHash",
    "codeHash",
    "entrypoints",
    "abi",
    "bytecode"
  ],
  "properties": {
    "artifactVersion": { "const": 1 },
    "compiler": { "const": "lithc" },
    "compilerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "contractName": { "type": "string", "minLength": 1 },
    "target": { "enum": ["lithovm-native-v11", "lithovm-native-v12", "lithovm-native-v13", "lithovm-native-v14"] },
    "bytecodeVersion": { "enum": [11, 12, 13, 14] },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "codeHash": { "$ref": "#/$defs/hash" },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "selector"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\([^)]*\\)$" },
          "selector": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "abi": { "type": "array" },
    "bytecode": { "type": "string", "pattern": "^0x[0-9a-f]+$" }
  },
  "oneOf": [
    { "properties": { "target": { "const": "lithovm-native-v11" }, "bytecodeVersion": { "const": 11 } } },
    { "properties": { "target": { "const": "lithovm-native-v12" }, "bytecodeVersion": { "const": 12 } } },
    { "properties": { "target": { "const": "lithovm-native-v13" }, "bytecodeVersion": { "const": 13 } } },
    { "properties": { "target": { "const": "lithovm-native-v14" }, "bytecodeVersion": { "const": 14 } } }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
